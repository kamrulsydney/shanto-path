---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Sponsor from '../../components/Sponsor.astro';
import { isPublicDomain, bn } from '../../lib/text';

export async function getStaticPaths() {
  // Build-time guard: refuse to publish anything still under copyright.
  const entries = (await getCollection('sahitya')).filter((e) => {
    const ok = isPublicDomain(e.data.authorDied);
    if (!ok) console.warn(`[sahitya] skipped "${e.data.title}": ${e.data.author} died ${e.data.authorDied}, still in copyright.`);
    return ok;
  });
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const isPoem = entry.data.kind === 'কবিতা';
---
<Base title={entry.data.title} description={entry.data.summary ?? `${entry.data.author} — ${entry.data.title}`}>
  <div class="with-aside">
    <article class="article measure" style="margin-inline:0">
      <header>
        <div class="meta"><span class="cat">{entry.data.kind}</span><span>{entry.data.author}</span>{entry.data.firstPublished && <span>{bn(entry.data.firstPublished)}</span>}</div>
        <h1>{entry.data.title}</h1>
      </header>
      <div class:list={['prose', { poem: isPoem }]}><Content /></div>
      <div class="source-box">
        {entry.data.author} মৃত্যুবরণ করেন {bn(entry.data.authorDied)} সালে। বাংলাদেশের কপিরাইট আইনে লেখকের মৃত্যুর ৬০ বছর পর লেখা সর্বসাধারণের হয়ে যায়, তাই এটি এখন পাবলিক ডোমেইনে।
      </div>
    </article>
    <Sponsor />
  </div>
</Base>
