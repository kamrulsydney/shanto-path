---
import { u } from '../lib/urls';
import Base from '../layouts/Base.astro';
import { SITE } from '../site';
import Subscribe from '../components/Subscribe.astro';
---
<Base title="আমাদের কথা">
  <article class="article measure prose">
    <h1>আমাদের কথা</h1>
    <p>{SITE.name} একটি পরিচ্ছন্ন বাংলা পত্রিকা ও ম্যাগাজিন। আমরা বিশ্বাস করি পড়া একটি শান্ত কাজ, আর পাঠকের মনোযোগ কোনো পণ্য নয়।</p>

    <h2>আমরা যা করি</h2>
    <ul>
      <li><strong>সংবাদ-সার:</strong> দিনের গুরুত্বপূর্ণ খবর আমাদের নিজের ভাষায় সংক্ষেপে লিখি, আর প্রতিটির সঙ্গে মূল প্রতিবেদনের লিংক দিই। আমরা কারও লেখা কপি করি না।</li>
      <li><strong>লেখা:</strong> আমাদের লেখকদের মৌলিক কলাম, প্রবন্ধ ও পর্যালোচনা।</li>
      <li><strong>সাহিত্য:</strong> বাংলা সাহিত্যের কালজয়ী লেখা, যেগুলোর কপিরাইটের মেয়াদ শেষ হয়েছে।</li>
    </ul>

    <h2 id="ads">বিজ্ঞাপন নীতি</h2>
    <p>পুরো সাইটে মাত্র একটি বিজ্ঞাপনের জায়গা আছে। কোনো পপ-আপ নেই, স্বয়ংক্রিয় ভিডিও নেই, লেখার মাঝখানে বিজ্ঞাপন নেই, আর পাঠককে অনুসরণ করার কোনো ট্র্যাকার নেই। পৃষ্ঠপোষক হতে চাইলে যোগাযোগ করুন।</p>

    <h2 id="email">দৈনিক ইমেইল</h2>
    <p>প্রতিদিন সকালে দিনের সংবাদ-সার এক ইমেইলে পাঠাই। কোনো ট্র্যাকিং পিক্সেল নেই, এক ক্লিকে বন্ধ করা যায়। ফিড রিডার ব্যবহার করলে <a href={u("/rss.xml")}>rss.xml</a> (সব লেখা) বা <a href={u("/daily.xml")}>daily.xml</a> (দিনে একটি) নিন।</p>
    <Subscribe />

    <h2>সদস্য হোন</h2>
    <p>শান্ত পাঠের খরচ চালাতে আমরা পাঠকদের ওপর নির্ভর করতে চাই, বিজ্ঞাপনদাতাদের ওপর নয়। সদস্যপদ শিগগিরই আসছে।</p>
  </article>
</Base>
